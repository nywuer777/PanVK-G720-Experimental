+/* UMA F4-DIAG: this variant is instrumentation ONLY. No changes to GPU
+ * synchronization, firmware ring contents or the heap renewal schedule.
+ * Each submission records sampled CPU wall time in coarse intervals.
+ * PANVK_G720_F4_PROFILE=0 disables profiling; enabled by default only for
+ * this dedicated diagnostics build. Times cannot measure GPU busy time.
+ */
+struct panvk_f4_profile {
+   uint64_t submits;
+   uint64_t total_ns;
+   uint64_t cpu_wait_ns;
+   uint64_t map_sync_ns;
+   uint64_t emit_ns;
+   uint64_t publish_ns;
+   uint64_t force_wait_ns;
+   uint64_t renew_wait_ns;
+   uint64_t renew_ns;
+   uint64_t ring_wait_ns;
+   uint64_t max_submit_ns;
+   uint64_t max_ring_wait_ns;
+   uint64_t ring_stalls;
+   uint64_t cpu_wait_submits;
+   uint64_t gpu_wait_submits;
+   uint64_t forced_submits;
+   uint64_t heap_renewals;
+};
+
+static _Thread_local struct panvk_f4_profile panvk_f4_stats;
+
+static bool
+panvk_f4_enabled(void)
+{
+   /* Per-thread cache avoids a static initialization race in vkQueueSubmit. */
+   static _Thread_local int enabled = -1;
+   if (enabled < 0)
+      enabled = debug_get_bool_option("PANVK_G720_F4_PROFILE", true);
+   return enabled != 0;
+}
+
+static inline uint64_t
+panvk_f4_elapsed(uint64_t *mark)
+{
+   uint64_t now = os_time_get_nano();
+   uint64_t delta = now >= *mark ? now - *mark : 0;
+   *mark = now;
+   return delta;
+}
+
+static void
+panvk_f4_snapshot(void)
+{
+   struct panvk_f4_profile *p = &panvk_f4_stats;
+   mesa_logi("PANVK-F4 submits=%" PRIu64 " total_ns=%" PRIu64
+             " cpu_wait_ns=%" PRIu64 " map_sync_ns=%" PRIu64
+             " emit_ns=%" PRIu64 " publish_ns=%" PRIu64
+             " forced_wait_ns=%" PRIu64 " renew_wait_ns=%" PRIu64
+             " renew_ns=%" PRIu64 " ring_wait_ns=%" PRIu64
+             " max_submit_ns=%" PRIu64 " max_ring_wait_ns=%" PRIu64
+             " ring_stalls=%" PRIu64 " cpu_wait_submits=%" PRIu64
+             " gpu_wait_submits=%" PRIu64 " forced_submits=%" PRIu64
+             " heap_renewals=%" PRIu64,
+             p->submits, p->total_ns, p->cpu_wait_ns, p->map_sync_ns,
+             p->emit_ns, p->publish_ns, p->force_wait_ns, p->renew_wait_ns,
+             p->renew_ns, p->ring_wait_ns, p->max_submit_ns,
+             p->max_ring_wait_ns, p->ring_stalls, p->cpu_wait_submits,
+             p->gpu_wait_submits, p->forced_submits, p->heap_renewals);
+   *p = (struct panvk_f4_profile){0};
+}
 
