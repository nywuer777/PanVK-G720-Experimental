+/* UMA F3: idle *large* BOs are kept in nondecreasing capacity order.
+ * Only entries released by panvk_pool_reset() enter this list. The caller
+ * retains responsibility for the existing GPU-completion/lifetime rule.
+ * The small-BO freelist intentionally keeps its previous FIFO semantics.
+ */
+static void
+panvk_uma_cache_idle_big_bo(struct panvk_bo_pool *cache,
+                            struct panvk_priv_bo *bo)
+{
+   const size_t capacity = pan_kmod_bo_size(bo->bo);
+
+   list_for_each_entry(struct panvk_priv_bo, cached, &cache->free_bos, node) {
+      if (pan_kmod_bo_size(cached->bo) > capacity) {
+         /* list_addtail() inserts directly before the selected element. */
+         list_addtail(&bo->node, &cached->node);
+         return;
+      }
+   }
+
+   list_addtail(&bo->node, &cache->free_bos);
+}
